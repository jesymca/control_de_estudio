					$t .= ' '.$matmil[$sub];
				}
				$mils = 0;
			}
			$neutro = true;
			$tex    = $t.$tex;
		}
		$tex     = $neg.substr($tex, 1).$fin;
		$end_num = $tex;
		return $end_num;
